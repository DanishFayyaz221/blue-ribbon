# Copy to .env.local and fill in. Never commit .env.local.

# MongoDB runs on the VPS bound to 127.0.0.1 with authentication enabled.
# It must never be reachable from the public internet.
#
# LOCAL DEVELOPMENT: reach it through an SSH tunnel rather than opening the
# port. Port 27018 is used locally because a local mongod may already hold
# 27017 — if it does, ssh silently binds IPv6 only and you end up querying the
# wrong database:
#
#   ssh -N -L 27018:127.0.0.1:27017 root@187.124.212.156
#
# Then verify with: npx tsx --env-file=.env.local scripts/check-db.ts
MONGODB_URI="mongodb://blueribbon:CHANGE_ME@127.0.0.1:27017/blueribbon?authSource=blueribbon"
MONGODB_DB="blueribbon"

# Absolute origin for listing photos. Leave EMPTY in production, where nginx
# serves /media/ from the same origin. Set to the live domain in local dev,
# because the image files only exist on the VPS.
#   NEXT_PUBLIC_MEDIA_ORIGIN="https://blueribbonrealestate.com.au"
NEXT_PUBLIC_MEDIA_ORIGIN=""

# Agency identifier assigned by Reapit. Every listing read filters on this —
# the Agentbox feed is multi-tenant and will carry other agencies' files.
REAPIT_AGENT_ID="BRB04"

# Where Agentbox drops REAXML files over SFTP.
# Deliberately outside the web root: these files contain vendor names, contact
# details and price expectations, and must not be publicly downloadable.
REAPIT_FEED_INCOMING="/srv/reapit-feed/incoming"
REAPIT_FEED_PROCESSED="/srv/reapit-feed/processed"
REAPIT_FEED_FAILED="/srv/reapit-feed/failed"

# Downloaded listing images. Self-hosted because hotlinking Reapit's images
# gets the feed disabled until resolved.
MEDIA_STORAGE_DIR="/srv/blueribbon/media"
MEDIA_PUBLIC_PREFIX="/media"

# Shared secret the ingest worker sends to the on-demand revalidation route
# so a feed update refreshes affected pages immediately.
REVALIDATE_SECRET="CHANGE_ME"

SITE_URL="https://blueribbonrealestate.com.au"

# EmailJS — powers the contact form and the property enquiry modal. Both send
# two emails per submit: a notification to the studio and a confirmation to the
# visitor. See lib/email/templates/README.md for the dashboard setup and the
# HTML to paste into each template.
#
# NEXT_PUBLIC_ by necessity: sending happens in the browser, so the public key
# is visible in the bundle. That is how EmailJS is designed — restrict the
# damage by adding the live domain (and localhost for dev) to the allowlist
# under EmailJS → Account → Security, or anyone can spend the quota.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=""
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=""
NEXT_PUBLIC_EMAILJS_NOTIFY_TEMPLATE=""
NEXT_PUBLIC_EMAILJS_REPLY_TEMPLATE=""

# Shown to the visitor as a fallback address when a send fails, and passed as
# to_email on the studio notification.
NEXT_PUBLIC_STUDIO_EMAIL="sales@blueribbonre.com.au"

# Public origin stamped into every image and link inside an outgoing email.
# Emails are read outside the browser that composed them, so these cannot use
# window.location: an enquiry submitted from localhost would otherwise embed
# http://localhost:3000/... URLs that no inbox can resolve.
NEXT_PUBLIC_SITE_URL="https://blueribbonrealestate.com.au"
